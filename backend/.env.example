DATABASE_URL=postgresql+asyncpg://guru:guru@localhost:5432/guru
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ANTHROPIC_API_KEY=
# Optional: enables multilingual vector search. Without it, keyword search is used.
VOYAGE_API_KEY=
DAILY_FREE_QUESTIONS=10

# Scholar review page at /admin. Share only with panel scholars. Empty = admin disabled.
ADMIN_API_KEY=

# Sign-in: comma-separated client IDs whose tokens are accepted
# Google: the Web client ID (and iOS client ID) from Google Cloud Console
GOOGLE_CLIENT_IDS=
# Apple: the iOS bundle ID (com.islamicguru.islamic_guru) and the Services ID used on Android
APPLE_CLIENT_IDS=

# Ask a Scholar: true = free users wait for payment (store billing not live yet)
ASK_SCHOLAR_REQUIRES_PAYMENT=true

# Local experiments only: create tables at startup instead of running migrations
AUTO_CREATE_TABLES=false
